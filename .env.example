# Copiază în .env și completează valorile.

# PostgreSQL
POSTGRES_DB=essenza
POSTGRES_USER=essenza
POSTGRES_PASSWORD=change-me

# API
JWT_SECRET=change-me-to-a-long-random-string
INTERNAL_API_SECRET=change-me-shared-with-scan-processor

# Floci (emulator AWS local)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=eu-central-1
AWS_ENDPOINT_URL=http://floci:4566
S3_BUCKET=essenza-images

# Modelul de embedding (aceeași valoare pentru scan-processor și ingest)
MODEL_VERSION=clip-vitb32-v0
